{
  "catalog_id": "daily-messages",
  "format_version": 1,
  "lookup_key": "YYYY-MM-DD|locale",
  "locales": ["tr", "en"],
  "initial_coverage_start": "2026-01-01",
  "initial_coverage_end": "2036-12-31",
  "initial_days": 4018,
  "initial_records_per_locale": 4018,
  "initial_total_records": 8036,
  "required_leap_dates": ["2028-02-29", "2032-02-29", "2036-02-29"],
  "rolling_release_horizon_years": 10,
  "runtime_ai_generation_allowed": false,
  "random_fallback_allowed": false,
  "machine_translation_between_tr_en_allowed": false,
  "required_fields": ["date", "locale", "title", "teaser", "full_text", "theme_tag"],
  "storage": {
    "model": "locale_period_csv_shards",
    "shards_root": "assets/content/daily_messages",
    "shard_patterns": ["{locale}/{year}.csv", "{locale}/{year}-{month}.csv"],
    "compiler": "tools/content/build_daily_message_catalog.py",
    "strict_auditor": "tools/content/validate_daily_message_catalog.py",
    "release_horizon_validator": "tools/content/validate_daily_message_release_horizon.py",
    "partial_editorial_audit_allowed_before_release": true,
    "release_audit_must_be_complete": true
  },
  "quality_gates": [
    "exact_date_locale_uniqueness",
    "no_missing_dates",
    "non_empty_fields",
    "exact_duplicate_detection",
    "near_duplicate_review",
    "repetitive_opening_pattern_review",
    "unsafe_certainty_review",
    "tr_en_independent_editorial_review",
    "rolling_ten_year_release_horizon"
  ],
  "quality_thresholds": {
    "near_duplicate_similarity": 0.90,
    "near_duplicate_min_shared_tokens": 4,
    "near_duplicate_max_token_document_ratio": 0.08,
    "repetitive_opening_max_uses": 19,
    "fail_on_near_duplicate": true,
    "fail_on_unsafe_certainty": true
  },
  "status": "EDITORIAL_CONTENT_COMPLETE_PENDING_RELEASE_AUDIT"
}
